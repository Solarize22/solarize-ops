{
  "name": "solarize-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "dev:reset": "powershell.exe -ExecutionPolicy Bypass -File scripts/reset-next-dev.ps1",
    "dev:test-reset": "powershell.exe -ExecutionPolicy Bypass -File scripts/reset-next-test.ps1",
    "preview:reset": "powershell.exe -ExecutionPolicy Bypass -File scripts/reset-next-preview.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "bootstrap:test-db": "node scripts/bootstrap-test-db.mjs --env-file .env.test.local --company-name \"Solarize CRM TEST\"",
    "repair:workflow-milestones": "node scripts/repair-workflow-milestones.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.0",
    "@neondatabase/serverless": "^1.0.2",
    "lucide-react": "^0.383.0",
    "next": "14.2.29",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8",
    "tailwindcss": "^3.3.0"
  }
}
